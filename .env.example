# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX          # your Twilio purchased number

# Target phone number (the Pretty Good AI scheduling bot)
TARGET_PHONE_NUMBER=+18054398008

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model overrides (optional)
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova       # alloy | echo | fable | onyx | nova | shimmer
OPENAI_WHISPER_MODEL=whisper-1

# ── Webhook / tunnel ──────────────────────────────────────────────────────────
# Run: ngrok http 5000   →  copy the https URL here
WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok.io
WEBHOOK_PORT=5000

# ── Call settings ─────────────────────────────────────────────────────────────
NUM_CALLS=10
RECORDING_CHANNELS=dual

# ── Local storage ─────────────────────────────────────────────────────────────
CALLS_DIR=calls
BUG_REPORT_PATH=BUGS.md

# ── Patient persona ───────────────────────────────────────────────────────────
PATIENT_NAME=Sarah Johnson
PATIENT_DOB=March 14, 1985
PATIENT_INSURANCE=BlueCross BlueShield PPO
PATIENT_REASON=I need to schedule a follow-up appointment for my lower back pain
